{
  "manifest_version": 3,
  "default_locale": "zh_CN",
  "name": "__MSG_extension_name__",
  "version": "1.0",
  "description": "__MSG_extension_description__",
  "permissions": [
    "activeTab",
    "scripting",
    "sidePanel",
    "storage"
  ],
  "host_permissions": [
    "https://ima.qq.com/*",
    "https://*.myqcloud.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; img-src * data: blob:; connect-src https://ima.qq.com https://*.myqcloud.com;"
  },
  "background": {
    "service_worker": "src/scripts/background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/scripts/content.js"],
      "css": ["src/styles/content.css"]
    }
  ],
  "icons": {
    "16": "src/assets/icons/icon16.png",
    "48": "src/assets/icons/icon48.png",
    "128": "src/assets/icons/icon128.png"
  },
  "action": {
    "default_title": "打开笔记侧边栏",
    "default_icon": {
      "16": "src/assets/icons/icon16.png",
      "48": "src/assets/icons/icon48.png",
      "128": "src/assets/icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "src/pages/sidebar.html"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "src/scripts/libs/marked.min.js",
        "src/assets/svg/code.svg",
        "src/assets/svg/全文.svg",
        "src/assets/svg/选取.svg",
        "src/assets/images/author.jpg",
        "src/assets/images/wx.jpg",
        "src/assets/images/zfb.jpg",
        "src/assets/icons/icon128.png"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
