{
  "manifest_version": 3,
  "name": "IMA笔记",
  "version": "1.0",
  "description": "选取网页内容并保存到 IMA 知识库",
  "permissions": [
    "activeTab",
    "scripting",
    "sidePanel",
    "storage"
  ],
  "host_permissions": [
    "https://ima.qq.com/*",
    "https://*.myqcloud.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; img-src * data: blob:; connect-src https://ima.qq.com https://*.myqcloud.com;"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"]
    }
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_title": "打开笔记侧边栏",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidebar.html"
  },
  "web_accessible_resources": [
    {
      "resources": ["marked.min.js", "code.svg", "author.jpg", "wx.jpg", "zfb.jpg"],
      "matches": ["<all_urls>"]
    }
  ]
}
